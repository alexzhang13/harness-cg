+def test_dummy_padding_batches_are_tiny(make_training_example):
+    """Rank-count padding must not cost a full micro batch of compute (fast-rlm speed finding)."""
+    from prime_rl.trainer.batch import DUMMY_BATCH_TOKENS
+
+    # 5 long samples (each ~ one bin) on 4 workers -> 5 bins + 3 dummies
+    examples = []
+    for _ in range(5):
+        ex = make_training_example()
+        ex.prompt_ids = [1] * 3000
+        ex.prompt_mask = [False] * 3000
+        ex.completion_ids = [2] * 1000
+        ex.completion_mask = [True] * 1000
+        ex.completion_logprobs = [-0.1] * 1000
+        ex.completion_temperatures = [1.0] * 1000
+        ex.teacher_logprobs = [0.0] * 4000
+        examples.append(ex)
+    batches_per_gpu = prepare_batch(rollouts=examples, seq_len=4096, num_train_workers=4, idxs=[0] * 5, num_loras=1)
+    assert all(len(w) == 2 for w in batches_per_gpu)
+    flat = [b for w in batches_per_gpu for b in w]
+    real = [b for b in flat if any(b.loss_mask)]
+    dummies = [b for b in flat if not any(b.loss_mask)]
+    assert len(real) == 5 and len(dummies) == 3
+    for d in dummies:
+        assert len(d.input_ids) == DUMMY_BATCH_TOKENS
+        for f in (d.loss_mask, d.advantages, d.inference_logprobs, d.position_ids, d.temperatures, d.env_names, d.teacher_logprobs):
+            assert len(f) == DUMMY_BATCH_TOKENS
+        assert d.position_ids == list(range(DUMMY_BATCH_TOKENS))
+        assert not any(d.loss_mask) and set(d.advantages) == {0.0}
+
+
+def test_balanced_packing_equalises_tokens_per_rank(make_training_example):
+    """32 samples of ~8k tokens on 4 ranks: FFD would give 9 bins (one rank 3 full bins); balanced gives 12
+    bins with near-equal tokens per rank and no full-size dummies."""
+    import random
+
+    rng = random.Random(0)
+    examples = []
+    for _ in range(32):
+        n = rng.randint(5000, 12000)
+        ex = make_training_example()
+        ex.prompt_ids = [1] * (n - 1000); ex.prompt_mask = [False] * (n - 1000)
+        ex.completion_ids = [2] * 1000; ex.completion_mask = [True] * 1000
+        ex.completion_logprobs = [-0.1] * 1000; ex.completion_temperatures = [1.0] * 1000
+        ex.teacher_logprobs = [0.0] * n
+        examples.append(ex)
+    total = sum(len(e.prompt_ids) + len(e.completion_ids) for e in examples)
+    per_gpu = prepare_batch(rollouts=examples, seq_len=32768, num_train_workers=4, idxs=[0] * 32, num_loras=1)
+    counts = [len(w) for w in per_gpu]
+    tokens = [sum(len(b.input_ids) for b in w) for w in per_gpu]
+    assert len(set(counts)) == 1                       # equal micro-batch counts per rank
+    assert sum(tokens) == total                        # nothing lost, no dummies needed
+    assert max(tokens) <= 1.15 * total / 4             # balanced within 15 % of the ideal share
+    assert all(len(b.input_ids) <= 32768 for w in per_gpu for b in w)
+    assert sum(sum(b.loss_mask) for w in per_gpu for b in w) == 32 * 1000

+def _balance_text_micro_batches(
+    samples: list[tuple[int, MicroBatch]], max_seq_len: int, num_train_workers: int, num_loras: int
+) -> list[MicroBatch]:
+    """Pack text-only samples into a number of micro batches divisible by ``num_train_workers``
+    with BALANCED token counts, instead of first-fit-decreasing (minimal bins) + full-size dummies.
+
+    Why: every data rank runs the same number of micro batches and the step waits for the slowest
+    rank. FFD on ~32 samples of ~8k tokens gives e.g. 9 near-full 32k bins; with 4 ranks that is
+    3 bins on one rank and 2 (+ a dummy) on the others, so the step costs 3 full bins (~96k tokens
+    of forward/backward on the critical rank) although the ideal share is ~64k. Re-packing the same
+    samples into 12 bins of ~21k tokens gives every rank ~64k tokens (micro batches are
+    variable-length tensors; nothing is padded to seq_len).
+
+    Algorithm: FFD to learn the minimal bin count B; target = ceil(B / W) * W bins; assign samples
+    longest-first to the currently lightest bin that has room (LPT with capacity); if none has room,
+    open W more bins. Bins are handed out in snake order so each rank gets the same number of bins
+    and near-equal tokens. Returns bins in rank-strided order (index i -> rank i % W), or [] for
+    groups containing multimodal samples (caller falls back to FFD + dummies).
+    """
+    import math
+
+    if not samples or any(_is_multimodal_sample(s) for _, s in samples):
+        return []
+    if len({s.training_mode for _, s in samples}) > 1:
+        return []  # micro batches must not mix training modes; fall back to the FFD path
+    lens = sorted((len(s.input_ids) for _, s in samples), reverse=True)
+    ffd_bins: list[int] = []
+    for L in lens:
+        for i, b in enumerate(ffd_bins):
+            if b + L <= max_seq_len:
+                ffd_bins[i] = b + L
+                break
+        else:
+            ffd_bins.append(L)
+    W = max(1, num_train_workers)
+    n_bins = math.ceil(len(ffd_bins) / W) * W
+    order = sorted(samples, key=lambda x: -len(x[1].input_ids))
+    while True:
+        bins: list[list[tuple[int, MicroBatch]]] = [[] for _ in range(n_bins)]
+        fill = [0] * n_bins
+        ok = True
+        for idx, s in order:
+            L = len(s.input_ids)
+            for i in sorted(range(n_bins), key=lambda i: fill[i]):
+                if fill[i] + L <= max_seq_len:
+                    bins[i].append((idx, s))
+                    fill[i] += L
+                    break
+            else:
+                ok = False
+                break
+        if ok:
+            break
+        n_bins += W
+    merged: list[MicroBatch] = []
+    for group in bins:
+        if not group:
+            continue
+        first = copy.deepcopy(group[0][1])
+        first.lora_num_tokens = [0] * num_loras
+        first.lora_num_tokens[group[0][0]] += len(group[0][1].input_ids)
+        for idx, s in group[1:]:
+            first.input_ids.extend(s.input_ids)
+            first.loss_mask.extend(s.loss_mask)
+            first.advantages.extend(s.advantages)
+            first.inference_logprobs.extend(s.inference_logprobs)
+            first.temperatures.extend(s.temperatures)
+            if s.teacher_logprobs is not None and first.teacher_logprobs is not None:
+                first.teacher_logprobs.extend(s.teacher_logprobs)
+            if s.routed_experts is not None and first.routed_experts is not None:
+                first.routed_experts.extend(s.routed_experts)
+            first.position_ids.extend(s.position_ids)
+            first.env_names.extend(s.env_names)
+            first.lora_num_tokens[idx] += len(s.input_ids)
+        merged.append(first)
+    while len(merged) < n_bins:  # empty bins (rare): tiny dummies keep counts equal
+        merged.append(_make_dummy_batch(merged[0]))
+    merged.sort(key=lambda b: -len(b.input_ids))
+    out: list[MicroBatch] = []
+    for r in range(0, len(merged), W):
+        row = merged[r:r + W]
+        if (r // W) % 2 == 1:
+            row = row[::-1]
+        out.extend(row)
+    return out
+

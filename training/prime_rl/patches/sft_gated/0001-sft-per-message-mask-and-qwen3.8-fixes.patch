+def _ce_kl_chunk(
+    hidden: Tensor, weight: Tensor, labels: Tensor, ref_hidden: Tensor | None
+) -> tuple[Tensor, Tensor]:
+    """Summed CE and summed full-vocab KL(policy || reference) over one chunk of tokens."""
+    logp = torch.log_softmax((hidden @ weight.t()).float(), dim=-1)
+    ce = -logp.gather(-1, labels.unsqueeze(-1)).sum()
+    if ref_hidden is None:
+        return ce, torch.zeros((), device=ce.device, dtype=ce.dtype)
+    with torch.no_grad():
+        logr = torch.log_softmax((ref_hidden @ weight.t()).float(), dim=-1)
+    kl = (logp.exp() * (logp - logr)).sum()
+    return ce, kl
+
+
+class FusedCEKLOutputLinear(torch.nn.Linear):
+    """lm_head for SFT with a KL penalty toward a reference policy.
+
+    The reference shares this lm_head (LoRA never adapts it), so the reference distribution
+    is fully determined by the reference's final hidden states. The trainer obtains those with
+    a no-grad forward in which LoRA is switched off and this head in `capture_hidden` mode, then
+    sets `ref_hidden` for the policy forward.
+
+    The policy forward returns loss = sum(CE) + kl_coef * sum(KL) over labelled tokens. Logits are
+    only ever materialised for `chunk_size` labelled tokens at a time, and each chunk is
+    activation-checkpointed, so the [N, V] logits never exist in full. Detached per-call sums are
+    left on `last_ce_sum` / `last_kl_sum` for logging.
+    """
+
+    IGNORE_INDEX = FUSED_CE_IGNORE_INDEX
+
+    def __init__(self, in_features: int, out_features: int, chunk_size: int = 1024, kl_coef: float = 0.0):
+        super().__init__(in_features, out_features, bias=False)
+        self.chunk_size = chunk_size
+        self.kl_coef = kl_coef
+        self.capture_hidden = False
+        self.captured_hidden: Tensor | None = None
+        self.ref_hidden: Tensor | None = None
+        self.last_ce_sum: Tensor | None = None
+        self.last_kl_sum: Tensor | None = None
+
+    def forward(
+        self,
+        hidden_states: torch.Tensor,
+        labels: torch.Tensor | None = None,
+        temperature: Tensor | None = None,
+    ) -> PrimeLmOutput:
+        if self.capture_hidden:
+            self.captured_hidden = hidden_states.detach()
+            return PrimeLmOutput()
+        if labels is None:
+            return PrimeLmOutput(logits=super().forward(hidden_states))
+
+        h = hidden_states.shape[-1]
+        hidden_flat = hidden_states.reshape(-1, h)
+        labels_flat = labels.reshape(-1)
+        idx = (labels_flat != self.IGNORE_INDEX).nonzero(as_tuple=True)[0]
+        hidden_sel = hidden_flat.index_select(0, idx)
+        labels_sel = labels_flat.index_select(0, idx)
+        ref_sel = None
+        if self.ref_hidden is not None:
+            assert self.ref_hidden.shape == hidden_states.shape, (
+                f"ref_hidden {tuple(self.ref_hidden.shape)} != hidden {tuple(hidden_states.shape)}"
+            )
+            ref_sel = self.ref_hidden.reshape(-1, h).index_select(0, idx)
+
+        ce_sum = hidden_states.new_zeros((), dtype=torch.float32)
+        kl_sum = hidden_states.new_zeros((), dtype=torch.float32)
+        for start in range(0, idx.numel(), self.chunk_size):
+            end = start + self.chunk_size
+            ce, kl = torch.utils.checkpoint.checkpoint(
+                _ce_kl_chunk,
+                hidden_sel[start:end],
+                self.weight,
+                labels_sel[start:end],
+                ref_sel[start:end] if ref_sel is not None else None,
+                use_reentrant=False,
+            )
+            ce_sum = ce_sum + ce
+            kl_sum = kl_sum + kl
+
+        self.last_ce_sum = ce_sum.detach()
+        self.last_kl_sum = kl_sum.detach()
+        return PrimeLmOutput(loss=ce_sum + self.kl_coef * kl_sum)
+

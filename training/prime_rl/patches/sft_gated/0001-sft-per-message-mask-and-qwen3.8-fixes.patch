+def _preload_cudnn_sublibs() -> None:
+    """dlopen every cuDNN sub-library now. cuDNN loads engine libs lazily on first use of a new conv shape; mid-run
+    that dlopen failed (CUDNN_STATUS_SUBLIBRARY_LOADING_FAILED, one rank dead -> 30 min NCCL hang), plausibly from
+    mmap exhaustion (vm.max_map_count = 65530 on some hosts). Loading them while the process is small avoids it."""
+    import ctypes
+    import glob
+    import os
+
+    try:
+        import nvidia.cudnn
+
+        libdirs = [os.path.join(d, "lib") for d in nvidia.cudnn.__path__]  # namespace package: no __file__
+    except ImportError:
+        return
+    # Sub-libraries depend on each other (cnn needs graph, engines need cnn); retry until no progress.
+    todo = sorted(f for d in libdirs for f in glob.glob(os.path.join(d, "libcudnn*.so*")))
+    errors: dict[str, str] = {}
+    while todo:
+        failed = []
+        for lib in todo:
+            try:
+                ctypes.CDLL(lib, mode=ctypes.RTLD_GLOBAL)
+            except OSError as e:
+                failed.append(lib)
+                errors[lib] = str(e)
+        if len(failed) == len(todo):
+            break
+        todo = failed
+    for lib in todo:
+        print(f"[cudnn preload] FAILED {lib}: {errors[lib]}", flush=True)
+
+
 def main():
     set_proc_title("SFTTrainer")
+    _preload_cudnn_sublibs()
     train(cli(SFTConfig))
 
 
